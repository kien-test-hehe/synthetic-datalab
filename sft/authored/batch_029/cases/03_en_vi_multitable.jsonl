{"case_id":"A029-17","split":"train","language_pair":"en-vi","sector":"healthcare","scenario_family":"tables_hospital_case_mix_reimbursement_cost","assumptions":"USD million except case counts and dollar rates. Toy reimbursement per discharge=base rate × case weight; cost includes all treated patients.","evidence":[{"id":"A","text":"|Ward|Discharges|Case weight|Cost per discharge USD|\n|---|---:|---:|---:|\n|Medical|2000|1.0|3500|\n|Surgical|1000|2.0|6500|\n|ICU|200|4.0|15000|"},{"id":"B","text":"Base rate $5,000 per weighted discharge; payer denies 5% of Surgical reimbursement, other wards accepted fully."},{"id":"C","text":"Fixed hospital expense $4m; no other revenue, tax or depreciation."},{"id":"D","text":"No patient outcomes or length of stay."}],"qas":[{"id":"a","question":"Số weighted discharges của ICU?","answer":"200×4=800.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":800,"unit":"weighted_cases"},"checks":[["200*4",800]]},{"id":"b","question":"Case mix index toàn viện?","answer":"(2000+2000+800)/(2000+1000+200)=1,5.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":1.5,"unit":"times"},"checks":[["(2000+1000*2+200*4)/(2000+1000+200)",1.5]]},{"id":"c","question":"Reimbursement Surgical sau denial?","answer":"1000×2×5000×.95/1e6=9,5 triệu USD.","evidence_ids":["A","B"],"oracle":{"kind":"numeric","value":9.5,"unit":"million_usd"},"checks":[["1000*2*5000*.95/1000000",9.5]]},{"id":"d","question":"Revenue accepted cả viện?","answer":"10+9,5+4=23,5 triệu USD.","evidence_ids":["A","B"],"oracle":{"kind":"numeric","value":23.5,"unit":"million_usd"},"checks":[["(2000+1000*2*.95+200*4)*5000/1000000",23.5]]},{"id":"e","question":"Tổng variable treatment cost?","answer":"7+6,5+3=16,5 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":16.5,"unit":"million_usd"},"checks":[["(2000*3500+1000*6500+200*15000)/1000000",16.5]]},{"id":"f","question":"Operating result sau fixed cost?","answer":"23,5−16,5−4=3 triệu USD.","evidence_ids":["A","B","C"],"oracle":{"kind":"numeric","value":3,"unit":"million_usd"},"checks":[["23.5-16.5-4",3]]},{"id":"g","question":"Vì sao denial không làm cost Surgical giảm tương ứng?","answer":"Điều trị đã thực hiện cho tất cả ca; denial giảm khoản được trả.","evidence_ids":["A","B"],"oracle":{"kind":"qualitative"},"checks":[]},{"id":"h","question":"Tính tỷ lệ tử vong theo severity?","answer":"Không có outcome hoặc dữ liệu tử vong.","evidence_ids":["D"],"oracle":{"kind":"insufficient"},"checks":[]}]}
{"case_id":"A029-18","split":"train","language_pair":"en-vi","sector":"logistics","scenario_family":"tables_logistics_route_backhaul_empty_miles","assumptions":"USD million, thousand km. Revenue per loaded km; cost per total km. No fixed costs allocated to routes.","evidence":[{"id":"A","text":"|Route|Loaded km k|Empty km k|Revenue $/loaded km|Cost $/total km|\n|---|---:|---:|---:|---:|\n|North|600|200|2.0|1.1|\n|South|400|300|2.4|1.2|\n|East|300|100|1.8|.9|"},{"id":"B","text":"Fixed fleet expense .6m. East backhaul option converts 50k empty km to loaded at $1.5/km; total km and variable cost unchanged."},{"id":"C","text":"All prices exclude VAT; no vehicle count or weights."},{"id":"D","text":"Management compares routes by headline rate only."}],"qas":[{"id":"a","question":"Loaded utilization North?","answer":"600/(600+200)=75%.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":75,"unit":"percent"},"checks":[["600/(600+200)*100",75]]},{"id":"b","question":"Contribution South trước fixed?","answer":"[400×2,4−700×1,2]/1000=.12 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":0.12,"unit":"million_usd"},"checks":[["(400*2.4-(400+300)*1.2)/1000",0.12]]},{"id":"c","question":"Contribution East trước backhaul?","answer":"[300×1,8−400×.9]/1000=.18 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":0.18,"unit":"million_usd"},"checks":[["(300*1.8-(300+100)*.9)/1000",0.18]]},{"id":"d","question":"Tổng fleet contribution trước fixed?","answer":" .32+.12+.18=.62 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":0.62,"unit":"million_usd"},"checks":[["(600*2-(600+200)*1.1+400*2.4-(400+300)*1.2+300*1.8-(300+100)*.9)/1000",0.62]]},{"id":"e","question":"Contribution tăng thêm backhaul?","answer":"50×1,5/1000=.075 triệu USD.","evidence_ids":["B"],"oracle":{"kind":"numeric","value":0.075,"unit":"million_usd"},"checks":[["50*1.5/1000",0.075]]},{"id":"f","question":"Fleet operating result sau backhaul và fixed?","answer":" .62+.075−.6=.095 triệu USD.","evidence_ids":["A","B"],"oracle":{"kind":"numeric","value":0.095,"unit":"million_usd"},"checks":[[".62+.075-.6",0.095]]},{"id":"g","question":"Tại sao South rate cao nhất không đảm bảo contribution cao nhất?","answer":"Empty km và cost per total km khác nhau.","evidence_ids":["A","D"],"oracle":{"kind":"qualitative"},"checks":[]},{"id":"h","question":"Tính tonne-km revenue?","answer":"Không. Thiếu trọng lượng hàng.","evidence_ids":["C"],"oracle":{"kind":"insufficient"},"checks":[]}]}
{"case_id":"A029-19","split":"train","language_pair":"en-vi","sector":"telecom","scenario_family":"tables_telecom_subscriber_arpu_churn_cohort","assumptions":"USD million, thousand subscribers. Toy monthly ARPU on average subscriber-months; subscriber closing bridge gross adds minus churn.","evidence":[{"id":"A","text":"|Plan|Opening k|Adds k|Churn k|Average k|Monthly ARPU $|\n|---|---:|---:|---:|---:|---:|\n|Basic|500|100|80|510|10|\n|Premium|200|60|20|220|25|\n|Enterprise|50|10|5|52|80|"},{"id":"B","text":"Annual service revenue = average subscribers × monthly ARPU × 12. No device revenue."},{"id":"C","text":"Network expense 90m; acquisition expense $30 per gross add across plans."},{"id":"D","text":"No customer counts by month or renewal timing."}],"qas":[{"id":"a","question":"Closing Basic subscribers?","answer":"500+100−80=520 nghìn.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":520,"unit":"thousand_subscribers"},"checks":[["500+100-80",520]]},{"id":"b","question":"Closing Premium subscribers?","answer":"200+60−20=240 nghìn.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":240,"unit":"thousand_subscribers"},"checks":[["200+60-20",240]]},{"id":"c","question":"Enterprise annual service revenue?","answer":"52×80×12/1000=49,92 triệu USD.","evidence_ids":["A","B"],"oracle":{"kind":"numeric","value":49.92,"unit":"million_usd"},"checks":[["52*80*12/1000",49.92]]},{"id":"d","question":"Total service revenue?","answer":"61,2+66+49,92=177,12 triệu USD.","evidence_ids":["A","B"],"oracle":{"kind":"numeric","value":177.12,"unit":"million_usd"},"checks":[["(510*10+220*25+52*80)*12/1000",177.12]]},{"id":"e","question":"Blended monthly ARPU on average subscribers?","answer":"(510×10+220×25+52×80)/(510+220+52)≈18,87468 USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":18.8746803069054,"unit":"usd_per_month"},"checks":[["(510*10+220*25+52*80)/(510+220+52)",18.8746803069054]]},{"id":"f","question":"Operating subtotal after network and acquisition?","answer":"177,12−90−170×30/1000=82,02 triệu USD.","evidence_ids":["A","B","C"],"oracle":{"kind":"numeric","value":82.02,"unit":"million_usd"},"checks":[["177.12-90-(100+60+10)*30/1000",82.02]]},{"id":"g","question":"Vì sao không dùng average ARPU đơn giản của 3 plans?","answer":"Subscriber mix khác nhau; phải weight theo subscriber-months.","evidence_ids":["A","B"],"oracle":{"kind":"qualitative"},"checks":[]},{"id":"h","question":"Tính chính xác monthly churn?","answer":"Không. Chỉ có annual gross churn, không timing và monthly base.","evidence_ids":["A","D"],"oracle":{"kind":"insufficient"},"checks":[]}]}
{"case_id":"A029-20","split":"train","language_pair":"en-vi","sector":"aviation","scenario_family":"tables_airline_route_ask_rpk_yield_cost","assumptions":"USD million, million seat-km and passenger-km. Toy passenger yield and unit cost as given, cargo excluded.","evidence":[{"id":"A","text":"|Route|ASK m|RPK m|Yield $/RPK|Variable $/ASK|\n|---|---:|---:|---:|---:|\n|Domestic|500|400|.12|.07|\n|Regional|300|240|.15|.09|\n|Longhaul|400|280|.18|.11|"},{"id":"B","text":"Fixed network cost 25m; other revenue 6m unrelated to routes."},{"id":"C","text":"No route-specific fixed cost; all RPK exclude nonrevenue passengers."},{"id":"D","text":"No aircraft count or schedule details."}],"qas":[{"id":"a","question":"Load factor Longhaul?","answer":"280/400=70%.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":70,"unit":"percent"},"checks":[["280/400*100",70]]},{"id":"b","question":"Passenger revenue Regional?","answer":"240×.15=36 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":36,"unit":"million_usd"},"checks":[["240*.15",36]]},{"id":"c","question":"Passenger revenue toàn mạng?","answer":"48+36+50,4=134,4 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":134.4,"unit":"million_usd"},"checks":[["400*.12+240*.15+280*.18",134.4]]},{"id":"d","question":"Variable cost toàn mạng?","answer":"35+27+44=106 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":106,"unit":"million_usd"},"checks":[["500*.07+300*.09+400*.11",106]]},{"id":"e","question":"Network passenger load factor?","answer":"920/1200≈76,6667%.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":76.6666666666667,"unit":"percent"},"checks":[["(400+240+280)/(500+300+400)*100",76.6666666666667]]},{"id":"f","question":"Operating result gồm other revenue?","answer":"134,4+6−106−25=9,4 triệu USD.","evidence_ids":["A","B"],"oracle":{"kind":"numeric","value":9.4,"unit":"million_usd"},"checks":[["134.4+6-106-25",9.4]]},{"id":"g","question":"Có thể kết luận Longhaul lỗ sau phân bổ fixed?","answer":"Không. Chưa có fixed allocation; chỉ tính direct contribution 6,4.","evidence_ids":["A","B"],"oracle":{"kind":"insufficient"},"checks":[]},{"id":"h","question":"Vì sao không dùng ASK để nhân passenger yield?","answer":"Yield trên RPK, ASK là capacity không phải flown passenger km.","evidence_ids":["A","C"],"oracle":{"kind":"qualitative"},"checks":[]}]}
{"case_id":"A029-21","split":"train","language_pair":"en-vi","sector":"agriculture","scenario_family":"tables_agriculture_crop_yield_quality_grade_margin","assumptions":"USD million, thousand tonnes. Toy all harvest sold; quality grades at separate prices; variable cost per hectare plus transport per tonne.","evidence":[{"id":"A","text":"|Crop|Area ha|Yield t/ha|Grade A share|A price $/t|B price $/t|\n|---|---:|---:|---:|---:|---:|\n|Rice|2000|5|.8|400|280|\n|Maize|1000|6|.7|300|200|"},{"id":"B","text":"|Crop|Growing cost $/ha|Transport $/t|\n|---|---:|---:|\n|Rice|1000|20|\n|Maize|900|25|"},{"id":"C","text":"Fixed shared cost .5m. No storage loss, taxes or subsidies."},{"id":"D","text":"No water use, yield uncertainty or market demand data."}],"qas":[{"id":"a","question":"Harvest rice?","answer":"2000×5=10.000 tấn.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":10000,"unit":"tonnes"},"checks":[["2000*5",10000]]},{"id":"b","question":"Revenue rice?","answer":"10000×(.8×400+.2×280)/1e6=3,76 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":3.76,"unit":"million_usd"},"checks":[["2000*5*(.8*400+.2*280)/1000000",3.76]]},{"id":"c","question":"Revenue maize?","answer":"6000×(.7×300+.3×200)/1e6=1,62 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":1.62,"unit":"million_usd"},"checks":[["1000*6*(.7*300+.3*200)/1000000",1.62]]},{"id":"d","question":"Total direct growing cost?","answer":"(2000×1000+1000×900)/1e6=2,9 triệu USD.","evidence_ids":["A","B"],"oracle":{"kind":"numeric","value":2.9,"unit":"million_usd"},"checks":[["(2000*1000+1000*900)/1000000",2.9]]},{"id":"e","question":"Total transport cost?","answer":"(10000×20+6000×25)/1e6=.35 triệu USD.","evidence_ids":["A","B"],"oracle":{"kind":"numeric","value":0.35,"unit":"million_usd"},"checks":[["(2000*5*20+1000*6*25)/1000000",0.35]]},{"id":"f","question":"Operating surplus sau shared cost?","answer":"3,76+1,62−2,9−.35−.5=1,63 triệu USD.","evidence_ids":["A","B","C"],"oracle":{"kind":"numeric","value":1.63,"unit":"million_usd"},"checks":[["3.76+1.62-2.9-.35-.5",1.63]]},{"id":"g","question":"Có lấy simple average giá A/B để tính doanh thu?","answer":"Không, share grade khác nhau.","evidence_ids":["A"],"oracle":{"kind":"qualitative"},"checks":[]},{"id":"h","question":"Có tính water productivity mỗi crop?","answer":"Không. Thiếu water use.","evidence_ids":["D"],"oracle":{"kind":"insufficient"},"checks":[]}]}
{"case_id":"A029-22","split":"train","language_pair":"en-vi","sector":"education","scenario_family":"tables_education_program_cohort_tuition_scholarship","assumptions":"USD million, student counts. Toy all students complete one year; tuition discounts reduce revenue; no deferred fees.","evidence":[{"id":"A","text":"|Program|Students|Sticker fee $|Scholarship share of fee|Delivery cost $/student|\n|---|---:|---:|---:|---:|\n|Engineering|1000|12000|15%|7000|\n|Business|800|10000|10%|5000|\n|Arts|400|8000|25%|4500|"},{"id":"B","text":"Central campus costs 5m; all scholarship percentages apply to gross cohort fees, no donor reimbursement."},{"id":"C","text":"No graduates' employment, payment timing or future enrollment."},{"id":"D","text":"Management slide compares sticker tuition only."}],"qas":[{"id":"a","question":"Net engineering tuition?","answer":"1000×12000×.85/1e6=10,2 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":10.2,"unit":"million_usd"},"checks":[["1000*12000*.85/1000000",10.2]]},{"id":"b","question":"Arts scholarship value?","answer":"400×8000×.25/1e6=.8 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":0.8,"unit":"million_usd"},"checks":[["400*8000*.25/1000000",0.8]]},{"id":"c","question":"Net business revenue?","answer":"800×10000×.9/1e6=7,2 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":7.2,"unit":"million_usd"},"checks":[["800*10000*.9/1000000",7.2]]},{"id":"d","question":"Total net tuition?","answer":"10,2+7,2+2,4=19,8 triệu USD.","evidence_ids":["A","B"],"oracle":{"kind":"numeric","value":19.8,"unit":"million_usd"},"checks":[["(1000*12000*.85+800*10000*.9+400*8000*.75)/1000000",19.8]]},{"id":"e","question":"Total delivery cost?","answer":"7+4+1,8=12,8 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":12.8,"unit":"million_usd"},"checks":[["(1000*7000+800*5000+400*4500)/1000000",12.8]]},{"id":"f","question":"Operating surplus sau campus cost?","answer":"19,8−12,8−5=2 triệu USD.","evidence_ids":["A","B"],"oracle":{"kind":"numeric","value":2,"unit":"million_usd"},"checks":[["19.8-12.8-5",2]]},{"id":"g","question":"Vì sao sticker tuition không phản ánh revenue/Student thực?","answer":"Scholarship giảm consideration.","evidence_ids":["A","D"],"oracle":{"kind":"qualitative"},"checks":[]},{"id":"h","question":"Có so sánh return to education cho sinh viên?","answer":"Không. Thiếu outcome và thu nhập sau tốt nghiệp.","evidence_ids":["C"],"oracle":{"kind":"insufficient"},"checks":[]}]}
{"case_id":"A029-23","split":"train","language_pair":"en-vi","sector":"mining","scenario_family":"tables_mining_ore_grade_recovery_payable_metal","assumptions":"USD million and thousand tonnes. Toy payable metal=ore tonnes×grade×recovery×payable percentage. No other minerals.","evidence":[{"id":"A","text":"|Mine|Ore kt|Grade|Recovery|Payable share|\n|---|---:|---:|---:|---:|\n|A|1000|2%|80%|95%|\n|B|800|1.5%|90%|90%|"},{"id":"B","text":"Metal price $8,000/t. Ore extraction+processing cost A $65/t ore, B $55/t ore."},{"id":"C","text":"Royalties 4% of payable metal revenue; fixed corporate cost 8m."},{"id":"D","text":"No capex, tax, reserves or byproduct credits."}],"qas":[{"id":"a","question":"Contained metal mine A?","answer":"1000×.02=20 nghìn tấn.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":20,"unit":"thousand_tonnes"},"checks":[["1000*.02",20]]},{"id":"b","question":"Payable metal mine B?","answer":"800×.015×.9×.9=9,72 nghìn tấn.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":9.72,"unit":"thousand_tonnes"},"checks":[["800*.015*.9*.9",9.72]]},{"id":"c","question":"Payable metal toàn bộ?","answer":"15,2+9,72=24,92 nghìn tấn.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":24.92,"unit":"thousand_tonnes"},"checks":[["1000*.02*.8*.95+800*.015*.9*.9",24.92]]},{"id":"d","question":"Total metal revenue?","answer":"24,92×8000/1000=199,36 triệu USD.","evidence_ids":["A","B"],"oracle":{"kind":"numeric","value":199.36,"unit":"million_usd"},"checks":[["(1000*.02*.8*.95+800*.015*.9*.9)*8000/1000",199.36]]},{"id":"e","question":"Total ore cost?","answer":"1000×65/1000+800×55/1000=109 triệu USD.","evidence_ids":["A","B"],"oracle":{"kind":"numeric","value":109,"unit":"million_usd"},"checks":[["(1000*65+800*55)/1000",109]]},{"id":"f","question":"Operating surplus sau royalty và corporate?","answer":"199,36×.96−109−8=74,3856 triệu USD.","evidence_ids":["A","B","C"],"oracle":{"kind":"numeric","value":74.3856,"unit":"million_usd"},"checks":[["199.36*.96-109-8",74.3856]]},{"id":"g","question":"Tại sao grade không đồng nghĩa payable metal share?","answer":"Còn recovery và payable deduction.","evidence_ids":["A"],"oracle":{"kind":"qualitative"},"checks":[]},{"id":"h","question":"Tính reserve life theo từng mine?","answer":"Không. Thiếu reserves.","evidence_ids":["D"],"oracle":{"kind":"insufficient"},"checks":[]}]}
{"case_id":"A029-24","split":"train","language_pair":"en-vi","sector":"utilities","scenario_family":"tables_water_utility_nonrevenue_water_tariff_blocks","assumptions":"USD million, million cubic meters. Toy billed volume equals produced less physical and commercial losses; tariff per billed m3.","evidence":[{"id":"A","text":"|District|Produced m3 m|Physical loss m|Commercial loss m|Tariff $/billed m3|\n|---|---:|---:|---:|---:|\n|A|50|8|2|.8|\n|B|30|6|3|1.0|\n|C|20|2|1|.6|"},{"id":"B","text":"Variable treatment cost $.25 per produced m3. Fixed network expense 15m."},{"id":"C","text":"Billing cash collection 90% of billed revenue, no opening AR or writeoff."},{"id":"D","text":"No pipe length, population or investment plan."}],"qas":[{"id":"a","question":"Billed volume district B?","answer":"30−6−3=21 triệu m³.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":21,"unit":"million_m3"},"checks":[["30-6-3",21]]},{"id":"b","question":"Non-revenue water total?","answer":"8+2+6+3+2+1=22 triệu m³.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":22,"unit":"million_m3"},"checks":[["8+2+6+3+2+1",22]]},{"id":"c","question":"NRW ratio tổng?","answer":"22/100=22%.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":22,"unit":"percent"},"checks":[["(8+2+6+3+2+1)/(50+30+20)*100",22]]},{"id":"d","question":"Billed revenue toàn utility?","answer":"40×.8+21×1+17×.6=63,2 triệu USD.","evidence_ids":["A"],"oracle":{"kind":"numeric","value":63.2,"unit":"million_usd"},"checks":[["(50-8-2)*.8+(30-6-3)*1+(20-2-1)*.6",63.2]]},{"id":"e","question":"Cash collections?","answer":"63,2×.9=56,88 triệu USD.","evidence_ids":["A","C"],"oracle":{"kind":"numeric","value":56.88,"unit":"million_usd"},"checks":[["63.2*.9",56.88]]},{"id":"f","question":"Operating result theo accrual?","answer":"63,2−25−15=23,2 triệu USD.","evidence_ids":["A","B"],"oracle":{"kind":"numeric","value":23.2,"unit":"million_usd"},"checks":[["63.2-(50+30+20)*.25-15",23.2]]},{"id":"g","question":"Vì sao treatment cost dùng produced volume?","answer":"Nước thất thoát vẫn đã được sản xuất/xử lý.","evidence_ids":["A","B"],"oracle":{"kind":"qualitative"},"checks":[]},{"id":"h","question":"Tính investment payback thay ống?","answer":"Không. Thiếu capex và mức loss reduction.","evidence_ids":["D"],"oracle":{"kind":"insufficient"},"checks":[]}]}
