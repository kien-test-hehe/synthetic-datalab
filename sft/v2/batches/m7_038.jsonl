{"parent_id":"A047-11-a","question":"What EAD results from facility A's drawn loan and converted unused commitment?","task":"basic_reasoning","difficulty":"easy","language":{"context":"mixed","question":"en","answer":"en"},"gold":{"answer":"160 billion VND.","short":["120 + 80 × 50% = 160."],"detailed":["[A] Convert only the undrawn portion with the stipulated CCF. 120 + 80 × 50% = 160."],"citations":["A"],"program":{"expression":"drawa+unuseda*ccfa/100","operands":{"drawa":{"value":120,"evidence_id":"A","label":"A drawn"},"unuseda":{"value":80,"evidence_id":"A","label":"A undrawn"},"ccfa":{"value":50,"evidence_id":"A","label":"A CCF percent"}}}}}
{"parent_id":"A047-11-b","question":"Calculate facility B's exposure at default including its undrawn commitment.","task":"basic_reasoning","difficulty":"easy","language":{"context":"mixed","question":"en","answer":"en"},"gold":{"answer":"108 billion VND.","short":["90 + 30 × 60% = 108."],"detailed":["[B] Combine full drawn balance and converted unused commitment. 90 + 30 × 60% = 108."],"citations":["B"],"program":{"expression":"drawb+unusedb*ccfb/100","operands":{"drawb":{"value":90,"evidence_id":"B","label":"B drawn"},"unusedb":{"value":30,"evidence_id":"B","label":"B undrawn"},"ccfb":{"value":60,"evidence_id":"B","label":"B CCF percent"}}}}}
{"parent_id":"A047-11-c","question":"What allowance relates exclusively to facility A's drawn principal?","task":"advanced_reasoning","difficulty":"medium","language":{"context":"mixed","question":"en","answer":"en"},"gold":{"answer":"0.96 billion VND.","short":["120 × 2% × 40% = 0.96."],"detailed":["[A][C] Use actual drawn exposure rather than total EAD for the asset allowance. 120 × 2% × 40% = 0.96."],"citations":["A","C"],"program":{"expression":"drawa*pda/100*lgda/100","operands":{"drawa":{"value":120,"evidence_id":"A","label":"A drawn"},"pda":{"value":2,"evidence_id":"A","label":"A PD percent"},"lgda":{"value":40,"evidence_id":"A","label":"A LGD percent"}}}}}
{"parent_id":"A047-11-d","question":"How much liability provision is attributable to facility B's unused commitment?","task":"multi_document","difficulty":"medium","language":{"context":"mixed","question":"en","answer":"en"},"gold":{"answer":"0.45 billion VND.","short":["30 × 60% × 5% × 50% = 0.45."],"detailed":["[B][C] Undrawn EAD is the unused commitment times CCF, then PD and LGD. 30 × 60% × 5% × 50% = 0.45."],"citations":["B","C"],"program":{"expression":"unusedb*ccfb/100*pdb/100*lgdb/100","operands":{"unusedb":{"value":30,"evidence_id":"B","label":"B undrawn"},"ccfb":{"value":60,"evidence_id":"B","label":"B CCF percent"},"pdb":{"value":5,"evidence_id":"B","label":"B PD percent"},"lgdb":{"value":50,"evidence_id":"B","label":"B LGD percent"}}}}}
{"parent_id":"A047-11-e","question":"What combined allowance reduces the carrying amount of the two drawn loan assets?","task":"multi_document","difficulty":"medium","language":{"context":"mixed","question":"en","answer":"en"},"gold":{"answer":"3.21 billion VND.","short":["0.96 + 90 × 5% × 50% = 3.21."],"detailed":["[A][B][C] Exclude both undrawn provisions from the drawn asset allowance. 0.96 + 90 × 5% × 50% = 3.21."],"citations":["A","B","C"],"program":{"expression":"drawa*pda/100*lgda/100+drawb*pdb/100*lgdb/100","operands":{"drawa":{"value":120,"evidence_id":"A","label":"A drawn"},"pda":{"value":2,"evidence_id":"A","label":"A PD percent"},"lgda":{"value":40,"evidence_id":"A","label":"A LGD percent"},"drawb":{"value":90,"evidence_id":"B","label":"B drawn"},"pdb":{"value":5,"evidence_id":"B","label":"B PD percent"},"lgdb":{"value":50,"evidence_id":"B","label":"B LGD percent"}}}}}
{"parent_id":"A047-11-f","question":"Find total liability provision on the two undrawn commitments.","task":"multi_document","difficulty":"medium","language":{"context":"mixed","question":"en","answer":"en"},"gold":{"answer":"0.77 billion VND.","short":["80 × 50% × 2% × 40% + 0.45 = 0.77."],"detailed":["[A][B][C] Calculate the two CCF-adjusted undrawn losses separately and sum them. 80 × 50% × 2% × 40% + 0.45 = 0.77."],"citations":["A","B","C"],"program":{"expression":"unuseda*ccfa/100*pda/100*lgda/100+unusedb*ccfb/100*pdb/100*lgdb/100","operands":{"unuseda":{"value":80,"evidence_id":"A","label":"A undrawn"},"ccfa":{"value":50,"evidence_id":"A","label":"A CCF percent"},"pda":{"value":2,"evidence_id":"A","label":"A PD percent"},"lgda":{"value":40,"evidence_id":"A","label":"A LGD percent"},"unusedb":{"value":30,"evidence_id":"B","label":"B undrawn"},"ccfb":{"value":60,"evidence_id":"B","label":"B CCF percent"},"pdb":{"value":5,"evidence_id":"B","label":"B PD percent"},"lgdb":{"value":50,"evidence_id":"B","label":"B LGD percent"}}}}}
{"parent_id":"A047-11-g","question":"What incremental combined ECL arises if both PDs double under the specified stress?","task":"multi_document","difficulty":"hard","language":{"context":"mixed","question":"en","answer":"en"},"gold":{"answer":"3.98 billion VND.","short":["Baseline ECL 3.21 + 0.77 = 3.98; doubling PD adds another 3.98."],"detailed":["[A][B][C][D] With unchanged EAD and LGD, total ECL is linear in PD; the increment equals baseline. Baseline ECL 3.21 + 0.77 = 3.98; doubling PD adds another 3.98."],"citations":["A","B","C","D"],"program":{"expression":"(drawa+unuseda*ccfa/100)*pda/100*lgda/100+(drawb+unusedb*ccfb/100)*pdb/100*lgdb/100","operands":{"drawa":{"value":120,"evidence_id":"A","label":"A drawn"},"unuseda":{"value":80,"evidence_id":"A","label":"A undrawn"},"ccfa":{"value":50,"evidence_id":"A","label":"A CCF percent"},"pda":{"value":2,"evidence_id":"A","label":"A PD percent"},"lgda":{"value":40,"evidence_id":"A","label":"A LGD percent"},"drawb":{"value":90,"evidence_id":"B","label":"B drawn"},"unusedb":{"value":30,"evidence_id":"B","label":"B undrawn"},"ccfb":{"value":60,"evidence_id":"B","label":"B CCF percent"},"pdb":{"value":5,"evidence_id":"B","label":"B PD percent"},"lgdb":{"value":50,"evidence_id":"B","label":"B LGD percent"}}}}}
