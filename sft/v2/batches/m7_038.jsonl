{"parent_id":"A047-12-f","question":"Find closing fund NAV after redeeming one million units at the prevailing price.","task":"multi_document","difficulty":"hard","language":{"context":"mixed","question":"en","answer":"en"},"gold":{"answer":"Approximately 122.283333 million USD.","short":["133.4 − 11.116667 ≈ 122.283333."],"detailed":["[A][B][C][D] Subtract actual redemption value, not original subscription price. 133.4 − 11.116667 ≈ 122.283333."],"citations":["A","B","C","D"],"program":{"expression":"(nav+gain+income-fee+subscription-loss)*(1-redeem/(units+subscription/((nav+gain+income-fee)/units)))","operands":{"nav":{"value":100,"evidence_id":"A","label":"opening NAV"},"gain":{"value":15,"evidence_id":"B","label":"portfolio gain"},"income":{"value":2,"evidence_id":"B","label":"interest cash"},"fee":{"value":1,"evidence_id":"B","label":"accrued fee"},"subscription":{"value":23.2,"evidence_id":"C","label":"subscription cash"},"loss":{"value":5.8,"evidence_id":"D","label":"later portfolio loss"},"redeem":{"value":1,"evidence_id":"D","label":"million units redeemed"},"units":{"value":10,"evidence_id":"A","label":"opening million units"}}}}}
