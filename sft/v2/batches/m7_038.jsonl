{"parent_id":"A047-12-c","question":"How many million fund units are issued for the new cash subscription?","task":"multi_document","difficulty":"medium","language":{"context":"mixed","question":"en","answer":"en"},"gold":{"answer":"2 million units.","short":["23.2/11.6 = 2."],"detailed":["[A][B][C] Use contemporaneous NAV per unit; no issue fee applies. 23.2/11.6 = 2."],"citations":["A","B","C"],"program":{"expression":"subscription/((nav+gain+income-fee)/units)","operands":{"subscription":{"value":23.2,"evidence_id":"C","label":"subscription cash"},"nav":{"value":100,"evidence_id":"A","label":"opening NAV"},"gain":{"value":15,"evidence_id":"B","label":"portfolio gain"},"income":{"value":2,"evidence_id":"B","label":"interest cash"},"fee":{"value":1,"evidence_id":"B","label":"accrued fee"},"units":{"value":10,"evidence_id":"A","label":"opening million units"}}}}}
{"parent_id":"A047-12-d","question":"What NAV remains after new capital and the subsequent portfolio loss but before redemption?","task":"multi_document","difficulty":"medium","language":{"context":"mixed","question":"en","answer":"en"},"gold":{"answer":"133.4 million USD.","short":["116 + 23.2 − 5.8 = 133.4."],"detailed":["[A][B][C][D] Subscription increases net assets; the later loss reduces them. 116 + 23.2 − 5.8 = 133.4."],"citations":["A","B","C","D"],"program":{"expression":"nav+gain+income-fee+subscription-loss","operands":{"nav":{"value":100,"evidence_id":"A","label":"opening NAV"},"gain":{"value":15,"evidence_id":"B","label":"portfolio gain"},"income":{"value":2,"evidence_id":"B","label":"interest cash"},"fee":{"value":1,"evidence_id":"B","label":"accrued fee"},"subscription":{"value":23.2,"evidence_id":"C","label":"subscription cash"},"loss":{"value":5.8,"evidence_id":"D","label":"later portfolio loss"}}}}}
