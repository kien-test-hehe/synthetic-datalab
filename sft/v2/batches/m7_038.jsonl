{"parent_id":"A047-12-a","question":"What NAV applies immediately before investors subscribe?","task":"advanced_reasoning","difficulty":"easy","language":{"context":"mixed","question":"en","answer":"en"},"gold":{"answer":"116 million USD.","short":["100 + 15 + 2 − 1 = 116."],"detailed":["[A][B] Accrue the fee even though unpaid, before processing capital flow. 100 + 15 + 2 − 1 = 116."],"citations":["A","B"],"program":{"expression":"nav+gain+income-fee","operands":{"nav":{"value":100,"evidence_id":"A","label":"opening NAV"},"gain":{"value":15,"evidence_id":"B","label":"portfolio gain"},"income":{"value":2,"evidence_id":"B","label":"interest cash"},"fee":{"value":1,"evidence_id":"B","label":"accrued fee"}}}}}
