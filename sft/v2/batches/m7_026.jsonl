{"parent_id":"A045-08-d","question":"Tổng chi tiền vào ngày 90 nếu tài trợ trả sớm bằng vay?","task":"advanced_reasoning","difficulty":"medium","language":{"context":"mixed","question":"vi","answer":"vi"},"gold":{"answer":"Khoảng 200,295890 tỷ VND.","short":["196 + 4,295890 ≈ 200,295890."],"detailed":["[A][B][C] Cộng gốc chiết khấu và lãi vay, so với hóa đơn đủ 200. 196 + 4,295890 ≈ 200,295890."],"citations":["A","B","C"],"program":{"expression":"invoice*(1-discount/100)*(1+rate/100*days/year)","operands":{"invoice":{"value":200,"evidence_id":"A","label":"hóa đơn"},"discount":{"value":2,"evidence_id":"A","label":"chiết khấu percent"},"rate":{"value":10,"evidence_id":"B","label":"lãi vay percent"},"days":{"value":80,"evidence_id":"B","label":"ngày vay"},"year":{"value":365,"evidence_id":"B","label":"ngày/năm"}}}}}
{"parent_id":"A045-08-e","question":"Lãi vay đơn năm tối đa để phương án trả sớm hòa với trả đủ ngày 90?","task":"advanced_reasoning","difficulty":"hard","language":{"context":"mixed","question":"vi","answer":"vi"},"gold":{"answer":"Khoảng 9,311224%.","short":["4/196 × 365/80 × 100 ≈ 9,311224%."],"detailed":["[A][B][C] Tiền lãi hòa vốn bằng số chiết khấu tiết kiệm được. 4/196 × 365/80 × 100 ≈ 9,311224%."],"citations":["A","B","C"],"program":{"expression":"(invoice*discount/100)/(invoice*(1-discount/100))*year/days*100","operands":{"invoice":{"value":200,"evidence_id":"A","label":"hóa đơn"},"discount":{"value":2,"evidence_id":"A","label":"chiết khấu percent"},"year":{"value":365,"evidence_id":"B","label":"ngày/năm"},"days":{"value":80,"evidence_id":"B","label":"ngày vay"}}}}}
{"parent_id":"A045-08-f","question":"Hạn mức hiện tại thiếu bao nhiêu để Đá Mây tài trợ toàn bộ trả sớm?","task":"basic_reasoning","difficulty":"easy","language":{"context":"mixed","question":"vi","answer":"vi"},"gold":{"answer":"6 tỷ VND.","short":["196 − 190 = 6."],"detailed":["[A][D] Không được trả sớm một phần nên thiếu hạn mức làm phương án bất khả thi. 196 − 190 = 6."],"citations":["A","D"],"program":{"expression":"invoice*(1-discount/100)-limit","operands":{"invoice":{"value":200,"evidence_id":"A","label":"hóa đơn"},"discount":{"value":2,"evidence_id":"A","label":"chiết khấu percent"},"limit":{"value":190,"evidence_id":"D","label":"hạn mức"}}}}}
