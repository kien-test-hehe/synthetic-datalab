{"parent_id":"A045-07-f","question":"Tiền bán năm hai thấp nhất trong downside để xây ngay đáp ứng sàn lỗ của hội đồng?","task":"advanced_reasoning","difficulty":"medium","language":{"context":"mixed","question":"vi","answer":"vi"},"gold":{"answer":"Khoảng 61,728395 triệu USD.","short":["(60 − 10)/0,81 ≈ 61,728395."],"detailed":["[A][C] NPV downside phải ít nhất −10; giải dòng thu cần thiết. (60 − 10)/0,81 ≈ 61,728395."],"citations":["A","C"],"program":{"expression":"(capex-floor)/d2","operands":{"capex":{"value":60,"evidence_id":"A","label":"đầu tư"},"floor":{"value":10,"evidence_id":"C","label":"mức lỗ tối đa"},"d2":{"value":0.81,"evidence_id":"C","label":"PV năm 2"}}}}}
{"parent_id":"A045-07-g","question":"Có nên chọn xây ngay chỉ vì NPV kỳ vọng dương?","task":"financial_explanation","difficulty":"medium","language":{"context":"mixed","question":"vi","answer":"vi"},"gold":{"answer":"Không.","short":["Bán đất tốt hơn và xây vi phạm sàn downside."],"detailed":["[A][B][C][D] Xây đủ ngân sách nhưng downside −11,4 dưới −10; bán đất có PV 37,5. Bán đất tốt hơn và xây vi phạm sàn downside."],"citations":["A","B","C","D"]}}
{"parent_id":"A045-07-h","question":"Có trừ 20 triệu giá đất đã trả riêng khỏi phương án xây?","task":"financial_explanation","difficulty":"easy","language":{"context":"mixed","question":"vi","answer":"vi"},"gold":{"answer":"Không.","short":["Giá đất đã trả là chi phí chìm chung."],"detailed":["[A][B] So dòng tiền tương lai; cơ hội bán đất được phản ánh qua phương án thay thế. Giá đất đã trả là chi phí chìm chung."],"citations":["A","B"]}}
{"parent_id":"A045-08-a","question":"Đá Mây được giảm bao nhiêu nếu trả hóa đơn vào ngày 10?","task":"basic_reasoning","difficulty":"easy","language":{"context":"mixed","question":"vi","answer":"vi"},"gold":{"answer":"4 tỷ VND.","short":["200 × 2% = 4."],"detailed":["[A] Chiết khấu áp lên toàn bộ hóa đơn. 200 × 2% = 4."],"citations":["A"],"program":{"expression":"invoice*discount/100","operands":{"invoice":{"value":200,"evidence_id":"A","label":"hóa đơn"},"discount":{"value":2,"evidence_id":"A","label":"chiết khấu percent"}}}}}
